# Copier vers `.env` sur le serveur :  cp .env.example .env
# Ne jamais commiter `.env`.

# --- Général ---
NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/dudu
JWT_SECRET=
PUBLIC_BASE_URL=https://www.dudugroup.sn

# CORS / origines déjà listées dans server.js ; ajuster si besoin

# Limitation requêtes (optionnel)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# --- Mise en relation chauffeur / course (km) ---
# Rayon initial notification chauffeurs (défaut 12 km dans le code)
# DRIVER_MATCH_INITIAL_RADIUS_KM=12
# Rayon étendu si besoin
# DRIVER_MATCH_EXPANDED_RADIUS_KM=25

# --- Courses planifiées (job cron) : rayon notification chauffeurs autour du pickup (km), défaut 20 ---
SCHEDULED_DRIVER_NOTIFY_RADIUS_KM=20

# --- Wave (paiement) ---
# WAVE_WEBHOOK_SECRET = « Signing secret » du webhook pour l’URL exacte ci-dessous (pas la clé API).
WAVE_MODE=production
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_CALLBACK_URL=https://www.dudugroup.sn/api/v1/mobile-payments/wave/webhook
# Numéro Wave Business (E.164) — affichage / cohérence avec le compte Wave
WAVE_BUSINESS_PHONE=+221771491330
# WAVE_WEBHOOK_MAX_SKEW_SEC=600
# WAVE_RESTRICT_PAYER_MOBILE=1
# WAVE_SUCCESS_URL=https://www.dudugroup.sn/payment/success
# WAVE_ERROR_URL=https://www.dudugroup.sn/payment/error

# --- Admin API (changer en production) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Firebase / FCM (optionnel) ---
