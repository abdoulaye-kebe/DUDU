# Optionnel : copier ce fichier en `assets/config/app.env` pour surcharger
# l’URL API (sinon la valeur par défaut versionnée dans assets/config/app.env est utilisée).
# Exemples :
# - Simulateur iOS : http://localhost:3000
# - Émulateur Android : http://10.0.2.2:3000
# - Appareil physique : http://<IP_LAN>:3000
DUDU_API_ORIGIN=https://www.dudugroup.sn

# WebRTC : fortement recommandé sur iPhone / réseaux mobiles (sinon appels « muets »).
# Exemple Twilio / Metered / votre propre coturn :
# WEBRTC_TURN_URL=turn:global.turn.twilio.com:3478?transport=tcp
# WEBRTC_TURN_USERNAME=…
# WEBRTC_TURN_CREDENTIAL=…
